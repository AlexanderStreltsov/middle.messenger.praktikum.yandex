{
  "name": "middle.messenger.praktikum.yandex",
  "private": true,
  "version": "0.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "vite build && node server.cjs",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "format:check": "prettier --check \"src/**/*.{ts,css,hbs}\"",
    "format:write": "prettier --write \"src/**/*.{ts,css,hbs}\"",
    "typecheck": "tsc --noEmit",
    "stylelint": "stylelint \"src/**/*.css\"",
    "stylelint:fix": "stylelint --fix \"src/**/*.css\"",
    "test": "mocha",
    "check": "npm run typecheck && npm run lint && npm run stylelint && npm run format:check && npm run test && npm run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "9.21.0",
    "@types/chai": "5.2.2",
    "@types/jsdom": "21.1.7",
    "@types/mocha": "10.0.10",
    "@types/sinon": "17.0.4",
    "@types/sinon-chai": "4.0.0",
    "@typescript-eslint/eslint-plugin": "8.25.0",
    "@typescript-eslint/parser": "8.25.0",
    "chai": "5.2.1",
    "eslint": "9.21.0",
    "eslint-config-prettier": "10.0.2",
    "eslint-plugin-prettier": "5.2.3",
    "globals": "16.0.0",
    "husky": "9.1.7",
    "jsdom": "26.1.0",
    "mocha": "11.7.1",
    "prettier": "3.5.2",
    "sinon": "21.0.0",
    "sinon-chai": "4.0.0",
    "stylelint": "16.14.1",
    "stylelint-config-standard": "37.0.0",
    "ts-node": "10.9.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.25.0",
    "vite": "6.1.0"
  },
  "dependencies": {
    "express": "4.21.2",
    "handlebars": "4.7.8"
  }
}
